{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AP-Suite",
  "version": "0.1.0",
  "identifier": "com.accessparalegal.apsuite",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "AP-Suite Desktop",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
